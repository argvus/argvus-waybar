# Maintainer: William C. Canin
pkgname=argvus-waybar
pkgver=0.2.0
pkgrel=1
pkgdesc="Waybar with immutable click coordinates for Argvus shell popups"
arch=('x86_64')
url='https://github.com/argvus/argvus-waybar'
license=('MIT')

_commit=6d60c8e02be67bb85bb9b1ea803f2fbcf0722002
_srcdir="Waybar-${_commit}"

depends=(
  'fmt'
  'gtk-layer-shell'
  'gtkmm3'
  'jack'
  'jsoncpp'
  'libdbusmenu-gtk3'
  'libevdev'
  'libinput'
  'libmm-glib'
  'libmpdclient'
  'libnl'
  'libpulse'
  'libsigc++'
  'libwireplumber'
  'libxkbcommon'
  'playerctl'
  'sndio'
  'spdlog'
  'upower'
  'wayland'
)
makedepends=(
  'cmake'
  'glib2-devel'
  'meson'
  'python-setuptools'
  'scdoc'
  'wayland-protocols'
)
optdepends=(
  'argvus-fonts: icons in the ARGVUS Waybar configurations'
)
provides=("waybar=${pkgver%%.argvus*}")
conflicts=('waybar' 'waybar-git')
backup=(
  'etc/xdg/waybar/config.jsonc'
  'etc/xdg/waybar/style.css'
)
source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=()

# shellcheck disable=SC1091
_functions_file="${startdir:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)}/../common/functions.sh"
. "$_functions_file"

prepare() {
  arch_normalize_source_tree
  arch_prepare_waybar_source
}

build() {
  arch_build_waybar
}

package() {
  arch_package_waybar
}
