+
+TEST_CASE("TextualWorkspaceAddresses", "[workspace-address]") {
+  waybar::util::JsonParser parser;
+  auto reply = parser.parse(R"({
+    "workspaces": [
+      {"address":"2", "id":2, "type":"normal", "name":"2"},
+      {"address":"proj-app-abc", "type":"normal", "name":"proj-app-abc"},
+      {"address":"proj-app-def", "type":"normal", "name":"proj-app-def"}
+    ],
+    "activeWorkspace":{"address":"proj-app-abc", "type":"normal", "name":"proj-app-abc"},
+    "client":{"workspace":{"address":"proj-app-abc", "type":"normal", "name":"proj-app-abc"}},
+    "window":{"address":"0x123", "class":"kitty"}
+  })");
+  hyprland::IPC::normalizeWorkspaceIds(reply);
+  const auto& workspaces = reply["workspaces"];
+  REQUIRE(workspaces[0]["id"].asInt() == 2);
+  const auto namedId = workspaces[1]["id"].asInt();
+  REQUIRE(namedId < -1000);
+  REQUIRE(namedId != workspaces[2]["id"].asInt());
+  REQUIRE(reply["activeWorkspace"]["id"].asInt() == namedId);
+  REQUIRE(reply["client"]["workspace"]["id"].asInt() == namedId);
+  REQUIRE(hyprland::IPC::workspaceId("proj-app-abc") == namedId);
+  REQUIRE_FALSE(reply["window"].isMember("id"));
+  hyprland::IPC::normalizeWorkspaceIds(reply);
+  REQUIRE(reply["activeWorkspace"]["id"].asInt() == namedId);
+}
+
+TEST_CASE("WorkspaceAddressCompatibility", "[workspace-address]") {
+  REQUIRE(hyprland::IPC::workspaceId("3") == 3);
+  REQUIRE(hyprland::IPC::workspaceId("name:proj-name") == hyprland::IPC::workspaceId("proj-name"));
+  REQUIRE(hyprland::IPC::workspaceId("-99") == -99);
+  REQUIRE(hyprland::IPC::workspaceId("special") == -99);
+  REQUIRE(hyprland::IPC::workspaceId("3-project") != 3);
+  REQUIRE(hyprland::IPC::workspaceId("proj-name") != hyprland::IPC::workspaceId("special:proj-name"));
+}
