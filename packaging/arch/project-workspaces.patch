+int IPC::workspaceId(const std::string& address) {
+  if (address.starts_with("name:")) return workspaceId(address.substr(5));
+  int numericId = 0;
+  const auto [end, error] = std::from_chars(address.data(), address.data() + address.size(), numericId);
+  if (error == std::errc{} && end == address.data() + address.size()) return numericId;
+  if (address == "special") return -99;
+  // These are process-local identities only, never dispatched back to Hyprland.
+  static std::mutex mutex;
+  static std::map<std::string, int> addresses;
+  std::lock_guard lock(mutex);
+  auto entry = addresses.try_emplace(address, -1000000 - static_cast<int>(addresses.size())).first;
+  return entry->second;
+}
+
+void IPC::normalizeWorkspaceIds(Json::Value& value) {
+  if (value.isObject()) {
+    if (!value.isMember("id") && value["address"].isString() && value["name"].isString() &&
+        (value["type"] == "normal" || value["type"] == "special")) {
+      value["id"] = workspaceId(value["address"].asString());
+    }
+    for (auto& child : value) normalizeWorkspaceIds(child);
+  } else if (value.isArray()) {
+    for (auto& child : value) normalizeWorkspaceIds(child);
+  }
 }
 
